    },
    {
      "id": "file:src/kvcompression/rl/trainers/rloo_gumbel_terminal_trainer.py",
      "type": "file",
      "name": "rloo_gumbel_terminal_trainer.py",
      "filePath": "src/kvcompression/rl/trainers/rloo_gumbel_terminal_trainer.py",
      "summary": "Extends RLOOTerminalTrainer with a Gumbel-noise-based trajectory collection strategy that replaces stochastic categorical sampling with Gumbel-top-k sorted ordering, enabling differentiable or diverse rank-based eviction decisions.",
      "tags": ["rl-training", "rloo", "gumbel", "trajectory-collection"],
      "complexity": "complex",
      "languageNotes": "Adds Gumbel noise (log(-log(u))) to agent scores before argsort, converting score ranking into a form of stochastic sorting without requiring categorical sampling."
    },
    {
      "id": "class:src/kvcompression/rl/trainers/rloo_gumbel_terminal_trainer.py:RLOOGumbelTrainer",
      "type": "class",
      "name": "RLOOGumbelTrainer",
      "filePath": "src/kvcompression/rl/trainers/rloo_gumbel_terminal_trainer.py",
      "lineRange": [18, 300],
      "summary": "Trainer subclass that overrides collect_trajectories and evaluate to use Gumbel-perturbed scores for producing sorted eviction orderings, while inheriting the RLOO policy update and metrics infrastructure from RLOOTerminalTrainer.",
      "tags": ["rl-training", "rloo", "gumbel", "trajectory-collection"],
      "complexity": "complex"
    },
    {
      "id": "file:src/kvcompression/rl/trainers/rloo_terminal_trainer.py",
      "type": "file",
      "name": "rloo_terminal_trainer.py",
      "filePath": "src/kvcompression/rl/trainers/rloo_terminal_trainer.py",
      "summary": "Core RLOO (Reward-Linked Online Optimization) trainer that manages the full RL training loop for KV cache eviction agents, including trajectory collection with sequential token eviction, policy updates with entropy regularization, EMA model maintenance, and evaluation with plotting utilities.",
      "tags": ["rl-training", "rloo", "policy-update", "trajectory-collection"],
      "complexity": "complex",
      "languageNotes": "Implements terminal-reward RL where each episode corresponds to evicting tokens from a KV cache sequence and the reward is only observed at episode termination; supports both sequential action-by-action eviction and precomputed-score bulk eviction modes."
    },
    {
      "id": "class:src/kvcompression/rl/trainers/rloo_terminal_trainer.py:RLOOTerminalTrainer",
      "type": "class",
      "name": "RLOOTerminalTrainer",
      "filePath": "src/kvcompression/rl/trainers/rloo_terminal_trainer.py",
      "lineRange": [29, 747],
      "summary": "Full-featured RLOO trainer orchestrating trajectory sampling from BaseEnvironment, advantage computation, policy gradient updates with entropy loss and gradient clipping, EMA-based evaluation agent, and per-metric logging and plotting across training and evaluation phases.",
      "tags": ["rl-training", "policy-gradient", "rloo", "trainer"],
      "complexity": "complex"
    }
