    {
      "id": "file:src/kvcompression/rl/agents/kv_sorting_agent.py",
      "type": "file",
      "name": "kv_sorting_agent.py",
      "filePath": "src/kvcompression/rl/agents/kv_sorting_agent.py",
      "summary": "Implements KVSamplingGroupedQueryAgent, a neural network agent that scores KV cache entries for eviction by combining projected key, value, positional, and query-aggregated features through an MLP, supporting grouped-query attention (GQA).",
      "tags": ["rl-agent", "neural-network", "kv-cache", "gqa"],
      "complexity": "complex",
      "languageNotes": "Builds separate feature streams (key projection, value projection, positional embedding, key-difference cosine similarity, query aggregation) that are concatenated and passed through an MLP for final eviction scoring."
    },
    {
      "id": "class:src/kvcompression/rl/agents/kv_sorting_agent.py:KVSamplingGroupedQueryAgent",
