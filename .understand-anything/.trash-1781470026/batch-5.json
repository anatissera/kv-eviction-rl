      "filePath": "src/kvcompression/rl/agents/kv_sorting_agent.py",
      "lineRange": [15, 273],
      "summary": "Concrete RL agent that produces per-token eviction scores for KV cache entries by projecting key/value tensors, computing positional and key-difference features, aggregating queries under GQA, and feeding combined features through a multi-layer MLP.",
      "tags": ["rl-agent", "kv-cache", "mlp", "feature-extraction"],
      "complexity": "complex"
    },
