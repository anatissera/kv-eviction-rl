    {
      "id": "file:src/kvcompression/costs.py",
      "type": "file",
      "name": "costs.py",
      "filePath": "src/kvcompression/costs.py",
      "summary": "Implements the core KV cache eviction cost computation, measuring the attention loss incurred by evicting cache entries at various cache sizes via batched tensor operations.",
      "tags": ["utility", "data-model", "validation"],
      "complexity": "complex",
      "languageNotes": "Uses PyTorch named-tuple-style dataclass (NamedTuple) for CostResult with a `.to(device)` convenience method; the batched_compute_cost function applies dynamic programming over sorted rankings to compute AUC-normalized future-attention cost."
    },
    {
      "id": "class:src/kvcompression/costs.py:CostResult",
      "type": "class",
      "name": "CostResult",
      "filePath": "src/kvcompression/costs.py",
      "lineRange": [17, 35],
      "summary": "Named-tuple-style dataclass holding the output of batched_compute_cost: per-sample cost, cost-per-cache-size, and valid sequence lengths, with a `.to(device)` method for device transfer.",
      "tags": ["data-model", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:src/kvcompression/costs.py:batched_compute_cost",
      "type": "function",
      "name": "batched_compute_cost",
      "filePath": "src/kvcompression/costs.py",
      "lineRange": [47, 145],
      "summary": "Computes the batched KV eviction cost for a set of rankings against ground-truth attention weights, returning AUC-normalized future-attention scores across all cache sizes.",
      "tags": ["utility", "validation"],
      "complexity": "complex"
    },
    {
      "id": "file:src/kvcompression/rl/environments/kvsorting_env.py",
      "type": "file",
      "name": "kvsorting_env.py",
      "filePath": "src/kvcompression/rl/environments/kvsorting_env.py",
      "summary": "Defines KVSortingEnvironmentV2, the RL environment in which per-head agents learn to rank KV cache entries by iteratively selecting tokens to evict and receiving rewards based on oracle-computed attention cost.",
      "tags": ["service", "event-handler", "middleware"],
      "complexity": "complex",
      "languageNotes": "Implements a gym-style step/reset API adapted for batched, multi-head KV ranking; supports both online stepping and offline chunked reward computation for RLOO training."
    },
    {
      "id": "class:src/kvcompression/rl/environments/kvsorting_env.py:KVSortingEnvironmentV2",
      "type": "class",
      "name": "KVSortingEnvironmentV2",
      "filePath": "src/kvcompression/rl/environments/kvsorting_env.py",
      "lineRange": [25, 428],
      "summary": "RL environment managing KV cache ranking episodes: loads batches of keys/queries, orchestrates step-wise token selection, computes oracle-based rewards, and exposes a chunk-level reward API for RLOO policy optimization.",
      "tags": ["service", "event-handler", "middleware"],
      "complexity": "complex"
    },
    {
