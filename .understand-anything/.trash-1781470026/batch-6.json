      "complexity": "complex"
    },
    {
      "id": "class:src/kvcompression/hooks/extractors.py:ExtractAttentionTensors",
      "type": "class",
      "name": "ExtractAttentionTensors",
      "filePath": "src/kvcompression/hooks/extractors.py",
      "lineRange": [18, 167],
      "summary": "Context manager that registers forward hooks on attention modules to intercept Q/K/V tensors and save them as safetensors files organized by layer and head, handling both GQA and MHA layouts.",
      "tags": ["middleware", "service", "event-handler"],
      "complexity": "complex",
      "languageNotes": "Handles both grouped-query attention (GQA) and multi-head attention (MHA) layouts by branching on the ratio of query heads to KV heads."
    },
