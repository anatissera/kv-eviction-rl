      "lineRange": [30, 241],
      "summary": "Orchestrates model loading, data setup, generation, and per-sample storage of attention tensors and tokens, using a thread pool for concurrent disk/S3 writes.",
      "tags": ["service", "data-pipeline", "entry-point"],
      "complexity": "complex"
    },
