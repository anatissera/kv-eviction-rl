      "filePath": "src/kvcompression/kv_cache/compression_strategy_protocol.py",
      "lineRange": [59, 73],
      "summary": "No-op compression strategy that always returns an all-ones mask, effectively disabling eviction for the assigned head.",
      "tags": ["compression", "strategy-pattern", "utility"],
      "complexity": "simple"
    },
    {
      "id": "class:src/kvcompression/kv_cache/compression_strategy_protocol.py:PressCompressionStrategy",
      "type": "class",
      "name": "PressCompressionStrategy",
      "filePath": "src/kvcompression/kv_cache/compression_strategy_protocol.py",
      "lineRange": [96, 197],
      "summary": "Compression strategy that wraps a kvpress BasePress scorer, optionally materializing attention weights for attention-based presses, then converts the scorer's output indices into a boolean keep-mask.",
