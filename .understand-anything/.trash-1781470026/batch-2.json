      "id": "file:src/kvcompression/attention_utils.py",
      "type": "file",
      "name": "attention_utils.py",
      "filePath": "src/kvcompression/attention_utils.py",
      "summary": "Core attention utility library providing functions to materialize full attention weight matrices, generate causal attention masks, and expand KV caches for grouped-query attention (GQA) heads across the kvcompression framework.",
      "tags": ["utility", "attention", "tensor-ops", "gqa", "kv-cache"],
      "complexity": "complex",
      "languageNotes": "All four functions are pure tensor operations with no class state; materialize_attention_weights handles causal masking, padding masks, and NaN cleanup in a single pass over 120+ lines."
    },
    {
      "id": "function:src/kvcompression/attention_utils.py:materialize_attention_weights",
      "type": "function",
      "name": "materialize_attention_weights",
      "filePath": "src/kvcompression/attention_utils.py",
      "lineRange": [12, 134],
      "summary": "Computes explicit softmax attention weight matrices from query and key tensors, handling causal masking, padding masks, and variable-length sequences while zeroing out NaN rows that arise from fully-masked queries.",
      "tags": ["attention", "utility", "masking", "softmax"],
      "complexity": "complex"
    },
    {
      "id": "function:src/kvcompression/attention_utils.py:get_attention_mask",
      "type": "function",
      "name": "get_attention_mask",
      "filePath": "src/kvcompression/attention_utils.py",
      "lineRange": [137, 159],
      "summary": "Generates a lower-triangular causal attention mask tensor for a given batch size and sequence length pair, suitable for autoregressive decoding.",
      "tags": ["attention", "utility", "masking"],
      "complexity": "simple"
    },
    {
      "id": "function:src/kvcompression/attention_utils.py:expand_kv_for_gqa",
      "type": "function",
      "name": "expand_kv_for_gqa",
      "filePath": "src/kvcompression/attention_utils.py",
      "lineRange": [162, 194],
      "summary": "Expands both key and value cache tensors from KV-head space to full query-head space for grouped-query attention by repeating each KV head across its associated query heads.",
      "tags": ["attention", "utility", "gqa", "kv-cache"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/kvcompression/attention_utils.py:expand_k_for_gqa",
      "type": "function",
      "name": "expand_k_for_gqa",
      "filePath": "src/kvcompression/attention_utils.py",
      "lineRange": [197, 220],
      "summary": "Expands only the key cache tensor from KV-head space to full query-head space for grouped-query attention, used when value expansion is not required.",
      "tags": ["attention", "utility", "gqa", "kv-cache"],
      "complexity": "simple"
    },
    {
      "id": "file:src/kvcompression/hooks/compressor.py",
      "type": "file",
      "name": "compressor.py",
      "filePath": "src/kvcompression/hooks/compressor.py",
      "summary": "Implements the KVCompressor context manager and LayerHeadCompressionConfig dataclass, providing the primary user-facing API for configuring and applying per-layer/per-head KV cache compression strategies via monkey-patched attention hooks.",
      "tags": ["middleware", "api-handler", "kv-cache", "compression", "context-manager"],
      "complexity": "complex",
      "languageNotes": "Uses a context manager pattern (__enter__/__exit__) to scope monkey-patching lifetime; includes multi-level conflict validation for wildcard vs. specific layer/head configs."
    },
    {
      "id": "class:src/kvcompression/hooks/compressor.py:LayerHeadCompressionConfig",
      "type": "class",
      "name": "LayerHeadCompressionConfig",
      "filePath": "src/kvcompression/hooks/compressor.py",
      "lineRange": [27, 57],
      "summary": "Dataclass representing a compression configuration for a specific layer/head combination, with wildcard support and priority ordering via specificity scoring and __lt__ for sort-based resolution.",
      "tags": ["configuration", "data-model", "compression"],
      "complexity": "simple"
    },
    {
      "id": "class:src/kvcompression/hooks/compressor.py:KVCompressor",
      "type": "class",
      "name": "KVCompressor",
      "filePath": "src/kvcompression/hooks/compressor.py",
      "lineRange": [60, 272],
      "summary": "Context-manager class that installs per-head compression configs into a model's attention layers by monkey-patching MHA forward methods, validates config consistency on construction, and exposes compress_caches() for explicit cache eviction.",
      "tags": ["middleware", "compression", "context-manager", "monkey-patch"],
      "complexity": "complex"
    },
