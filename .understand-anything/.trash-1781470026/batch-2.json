      "type": "file",
      "name": "__init__.py",
      "filePath": "src/kvcompression/kv_cache/__init__.py",
      "summary": "Package barrel for the kv_cache subpackage, re-exporting CompressibleKVCache and CompressionStrategy (and related classes) as the public surface of the module.",
      "tags": ["entry-point", "barrel", "kv-cache"],
      "complexity": "simple"
    },
    {
      "id": "file:src/kvcompression/kv_cache/compressible_attention.py",
      "type": "file",
      "name": "compressible_attention.py",
      "filePath": "src/kvcompression/kv_cache/compressible_attention.py",
      "summary": "Contains the monkey-patched MHA forward pass and setup_cache functions that replace standard torchtune MultiHeadAttention behavior with a compressible variant that routes KV updates through CompressibleKVCache and applies per-head compression strategies.",
      "tags": ["middleware", "attention", "monkey-patch", "kv-cache", "compression"],
      "complexity": "complex",
      "languageNotes": "monkey_patched_mha_forward handles both prefill and decode paths, uses torch.compile-compatible flex_attention for the actual attention computation, and dispatches to CompressibleKVCache.update and compress."
    },
    {
      "id": "function:src/kvcompression/kv_cache/compressible_attention.py:monkey_patched_setup_cache",
      "type": "function",
      "name": "monkey_patched_setup_cache",
      "filePath": "src/kvcompression/kv_cache/compressible_attention.py",
      "lineRange": [38, 74],
      "summary": "Replacement for MultiHeadAttention.setup_cache that instantiates a CompressibleKVCache with a per-head strategy mapping derived from the supplied layer/head configs.",
      "tags": ["middleware", "kv-cache", "monkey-patch", "factory"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/kvcompression/kv_cache/compressible_attention.py:_build_head_strategy_mapping",
      "type": "function",
      "name": "_build_head_strategy_mapping",
      "filePath": "src/kvcompression/kv_cache/compressible_attention.py",
      "lineRange": [77, 124],
      "summary": "Builds a head-index-to-CompressionStrategy mapping for a given layer by resolving matching LayerHeadCompressionConfig entries by specificity, falling back to DummyCompressionStrategy for unconfigured heads.",
      "tags": ["factory", "compression", "configuration"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/kvcompression/kv_cache/compressible_attention.py:monkey_patched_mha_forward",
      "type": "function",
      "name": "monkey_patched_mha_forward",
      "filePath": "src/kvcompression/kv_cache/compressible_attention.py",
      "lineRange": [127, 270],
      "summary": "Full replacement forward pass for MultiHeadAttention that performs QKV projection, RoPE embedding, GQA expansion, CompressibleKVCache update, mask construction, and flex_attention computation in a single unified function.",
      "tags": ["attention", "middleware", "monkey-patch", "kv-cache"],
      "complexity": "complex"
    },
    {
      "id": "file:src/kvcompression/kv_cache/compressible_kv_cache.py",
      "type": "file",
      "name": "compressible_kv_cache.py",
      "filePath": "src/kvcompression/kv_cache/compressible_kv_cache.py",
      "summary": "Defines CompressibleKVCache, a KVCache subclass that stores per-head compression strategy objects alongside K/V/Q tensors and implements compress() to selectively evict cache entries using strategy-derived boolean masks.",
      "tags": ["kv-cache", "data-model", "compression", "service"],
      "complexity": "complex",
      "languageNotes": "Extends torchtune KVCache; uses register_buffer for all tensors so they participate in device/dtype moves and checkpointing; compress() runs per-head strategy evaluation and scatters surviving entries."
    },
    {
      "id": "class:src/kvcompression/kv_cache/compressible_kv_cache.py:CompressibleKVCache",
      "type": "class",
      "name": "CompressibleKVCache",
      "filePath": "src/kvcompression/kv_cache/compressible_kv_cache.py",
      "lineRange": [19, 298],
      "summary": "Extends the base KVCache with per-head CompressionStrategy support, providing update(), compress(), and get_k_v_and_mask_for_attention() to manage evictable KV entries during autoregressive generation.",
      "tags": ["kv-cache", "data-model", "compression", "eviction"],
      "complexity": "complex"
    },
    {
      "id": "file:src/kvcompression/kv_cache/compressible_mha_layer.py",
      "type": "file",
      "name": "compressible_mha_layer.py",
      "filePath": "src/kvcompression/kv_cache/compressible_mha_layer.py",
      "summary": "Defines CompressibleMultiHeadAttention, a thin wrapper around torchtune MultiHeadAttention that adds a reset_cache() method and is the target class whose forward/setup_cache methods are monkey-patched by the hooks layer.",
      "tags": ["component", "attention", "middleware", "kv-cache"],
      "complexity": "simple",
      "languageNotes": "The class itself has minimal logic; its instances become compressible at runtime through monkey-patching from compressible_attention.py and hooks/compressor.py."
    },
    {
      "id": "class:src/kvcompression/kv_cache/compressible_mha_layer.py:CompressibleMultiHeadAttention",
      "type": "class",
      "name": "CompressibleMultiHeadAttention",
      "filePath": "src/kvcompression/kv_cache/compressible_mha_layer.py",
      "lineRange": [20, 96],
      "summary": "MultiHeadAttention subclass that carries a CompressibleKVCache reference and exposes reset_cache() for clearing the KV state between sequences.",
      "tags": ["component", "attention", "kv-cache"],
      "complexity": "moderate"
    },
    {
      "id": "file:src/kvcompression/kv_cache/compression_strategy_protocol.py",
      "type": "file",
      "name": "compression_strategy_protocol.py",
      "filePath": "src/kvcompression/kv_cache/compression_strategy_protocol.py",
      "summary": "Defines the CompressionStrategy Protocol and its concrete implementations: DummyCompressionStrategy (keep all), RandomCompressionStrategy (random eviction), and PressCompressionStrategy (delegates to a BasePress scorer for importance-based eviction).",
      "tags": ["type-definition", "compression", "strategy-pattern", "kv-cache"],
      "complexity": "complex",
      "languageNotes": "Uses typing.Protocol for structural subtyping; PressCompressionStrategy bridges the kvcompression framework to the kvpress BasePress interface by calling press() to obtain per-token scores and converting them to boolean keep masks."
    },
    {
      "id": "class:src/kvcompression/kv_cache/compression_strategy_protocol.py:CompressionStrategy",
      "type": "class",
      "name": "CompressionStrategy",
      "filePath": "src/kvcompression/kv_cache/compression_strategy_protocol.py",
      "lineRange": [18, 56],
      "summary": "Abstract Protocol defining the CompressionStrategy interface: a get_mask() method that returns a boolean keep-mask tensor given KV cache contents and a target budget.",
      "tags": ["type-definition", "strategy-pattern", "compression"],
      "complexity": "simple"
    },
    {
      "id": "class:src/kvcompression/kv_cache/compression_strategy_protocol.py:DummyCompressionStrategy",
