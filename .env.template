# Environment variables for ml-learning-to-evict
# Copy this file to .env and customize the values for your setup
# Usage: source .env

# Required: Root directory for preprocessed data (e.g., RULER benchmark activations)
# This should point to where you store safetensors files generated by the preprocessing scripts
# For local testing with downloaded data, use: /dev/shm/data
export KVCOMPRESSION_DATA_ROOT=data

# Required: HuggingFace model ID or local path to model weights
# Examples: "Qwen/Qwen2.5-7B-Instruct" or "./models/Qwen2.5-7B-Instruct"
export KVCOMPRESSION_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Optional: S3/Cloud storage configuration (for remote agent storage, data preprocessing upload)
# export AWS_PROFILE=your-aws-profile
# export AWS_ENDPOINT_URL=https://s3.amazonaws.com
# export AWS_VERIFY_SSL=true

# Required for S3 operations: S3 bucket name for data and agent storage
# This is used by download_data.py, agent_registry.py, and training upload
export KVCOMPRESSION_S3_BUCKET=your-bucket-name

# Optional: Weights & Biases configuration
# export WANDB_BASE_URL=https://wandb.ai
# export WANDB_PROJECT=ml-learning-to-evict
# export WANDB_ENTITY=your-team

# Optional: Disable torch.compile for debugging
# export DISABLE_TORCH_COMPILER=1
